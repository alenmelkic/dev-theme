{
	"name": "vite-wordpress-theme",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "rimraf ./dist && vite",
		"build:vite": "vite build",
		"build:vite:prod": "cross-env NODE_ENV=production vite build",
		"build:block:soundcloud": "wp-scripts build blocks/soundcloud/index.jsx --output-path=dist/blocks/soundcloud",
		"build:block:facebook-video": "wp-scripts build blocks/facebook-video/index.jsx --output-path=dist/blocks/facebook-video",
		"build:block:youtube-video": "wp-scripts build blocks/youtube-video/index.jsx --output-path=dist/blocks/youtube-video",
		"build:block:category-articles": "wp-scripts build blocks/category-articles/index.jsx --output-path=dist/blocks/category-articles",
		"build:block:image-gallery": "wp-scripts build blocks/image-gallery/index.jsx blocks/image-gallery/view.js --output-path=dist/blocks/image-gallery",
		"build:block:mini-banners": "wp-scripts build blocks/mini-banners/index.jsx blocks/mini-banners/view.js --output-path=dist/blocks/mini-banners",
		"build:blocks": "npm run build:block:soundcloud && npm run build:block:facebook-video && npm run build:block:youtube-video && npm run build:block:category-articles && npm run build:block:image-gallery && npm run build:block:mini-banners",
		"build": "npm run build:vite && npm run build:blocks",
		"build:prod": "npm run build:vite:prod && npm run build:blocks",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@playwright/test": "^1.56.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.6",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.0.3",
		"@vitest/ui": "^3.2.4",
		"@wordpress/blocks": "^15.4.0",
		"@wordpress/components": "^30.4.0",
		"@wordpress/editor": "^14.31.0",
		"@wordpress/element": "^6.31.0",
		"@wordpress/scripts": "^30.24.0",
		"cross-env": "^10.1.0",
		"jsdom": "^27.0.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"rimraf": "6.0.1",
		"sass": "1.90.0",
		"typescript": "^5.9.3",
		"vite": "7.1.2",
		"vite-plugin-purgecss": "^0.2.13",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@swup/a11y-plugin": "^5.0.0",
		"@swup/body-class-plugin": "^3.3.0",
		"@swup/head-plugin": "^2.3.1",
		"@swup/progress-plugin": "^3.2.0",
		"@swup/scripts-plugin": "^2.1.0",
		"@tanstack/react-query": "^5.90.10",
		"bootstrap": "5.3.7",
		"photoswipe": "^5.4.4",
		"swup": "^4.8.2"
	}
}